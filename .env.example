# Optional. Local CLI reads environment variables; source/export deliberately or use a process manager.
# HORTATOR_DATA_DIR=./data
# HORTATOR_ADMIN_PASSWORD=replace-with-a-unique-long-password
# Set 1 only when the browser connects over HTTPS.
HORTATOR_SECURE_COOKIES=0
# Usually unnecessary: serve API and dashboard from the same origin.
# HORTATOR_ALLOWED_ORIGINS=https://council.example.com
# An existing master.key is generated automatically. Do not replace its key for an existing database.
# HORTATOR_MASTER_KEY=your-existing-fernet-key
